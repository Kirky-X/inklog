# =============================================================================
# inklog — .gitignore
# 结构:统一公共段(7 仓库同源,见 base/CONFIG_BASELINE.md)+ 仓库特有段
# 注意:Cargo.lock 与 rust-toolchain.toml 纳入版本控制,不再忽略
# =============================================================================

# =============================================================================
# 统一公共段
# =============================================================================

# --- Build artifacts (Rust) ---
/target
/debug
/release
**/*.rs.bk

# Cargo 本地覆盖(.cargo/config.toml 等机器特定配置)
.cargo/

# --- Code coverage ---
coverage/
*.profraw
*.profdata
*.gcda
*.gcno
lcov.info
*.lcov
htmlcov/
tarpaulin-report.html

# --- IDE & Editors ---
.idea/
.vscode/
.vscodeignore
.idea_modules/
*.code-workspace
*.sublime-*
.nvimrc
*.swp
*.swo
*~
.un~
Session.vim
.netrwhist

# --- OS generated ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Logs ---
*.log
logs/
*.pid
*.seed

# --- Temporary files ---
*.tmp
*.temp
*.bak
*.orig
*.rej
tmp/
temp/

# --- Environment & secrets (never commit) ---
.env
.env.local
.env.*.local
.env.production
.env.development
*.pem
*.key
*.crt
*.secret
*.credentials
.pre-commit-check.log

# --- Local config / AI assistant files (kept local only) ---
.local-registry/
.claude/
.qoder/
.opencode/
.cursor/
.aider/
.continue/
.codeium/
.iflow/
.sisyphus/
.github/copilot/
CLAUDE.md
IFLOW.md
GEMINI.md
CODEIUM.md
AGENTS.md
openspec/
specmark/
**/specmark/
.codenexus/
**/.codenexus/
strix_runs/
.worktrees/
.gitnexus

# --- Reviews / security scan artifacts (never tracked) ---
reviews/
.mimosa/

# --- WorkBuddy AI local notes ---
.workbuddy-ai/

# =============================================================================
# 仓库特有段(inklog)
# =============================================================================

# --- IDE / Editor 扩展 ---
.fleet/
.jb/
*.sublime-project
*.sublime-workspace

# --- OS 扩展 ---
._*
.Spotlight-V100
.Trashes
desktop.ini

# --- 日志轮转产物(inklog 自测产生的轮转日志文件) ---
*.log.*

# --- 测试产物 ---
test_results/
*.cover

# --- 环境与密钥(扩展) ---
*.env
.env.test
secrets/

# --- 备份文件 ---
*.backup
*.old

# --- 本仓内部文档草稿(定稿前不入库) ---
docs/prd.md
docs/task.md
docs/tdd.md
docs/test.md
docs/uat.md
docs/archive/

# --- Rust 构建副产物 ---
*.pdb

# --- 覆盖率(扩展格式) ---
cobertura.xml

# --- 依赖目录 / 前端包管理器 ---
vendor/
node_modules/
.npm/
.yarn/
bower_components/
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- 归档文件 ---
*.tar.gz
*.zip
*.rar
*.7z

# --- 本地数据库文件 ---
*.db
*.sqlite
*.sqlite3

# --- 云存储配置 ---
.s3cfg
.aws/

# --- Docker 本地覆盖(docker-compose.test.yml 为 CI 基座,纳入版本控制) ---
.dockerignore.local
docker-compose.test.yml

# --- 缓存 / 进程文件 ---
.cache/
*.pid.lock
